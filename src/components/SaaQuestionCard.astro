---
import type { CollectionEntry } from 'astro:content';
import FlipCard from './FlipCard.astro';

interface Props {
	question: CollectionEntry<'awsSaa'>;
	/** 固定卡片高度；不传则由内容撑开，见 FlipCard */
	height?: string;
	minHeight?: string;
}

const { question, height, minHeight } = Astro.props;
const { index, total, type, question: stem, options, answer } = question.data;

// 正确答案是紧挨着的字母串："A" 或多选的 "AD"，拆开后跟选项开头的字母对上。
const correctLetters = answer.correct.split('').filter((c) => /[A-Z]/.test(c));
const letterOf = (option: string) => option.match(/^([A-Z])/)?.[1] ?? '';
const correctOptions = options.filter((option) => correctLetters.includes(letterOf(option)));
---

<FlipCard height={height} minHeight={minHeight}>
	<Fragment slot="front">
		<div class="meta">
			<span class="badge badge-index">第 {index} / {total} 题</span>
			<span class="badge badge-type">{type}</span>
		</div>
		<p class="stem">{stem}</p>
		<ul class="options">
			{options.map((option) => <li>{option}</li>)}
		</ul>
	</Fragment>

	<Fragment slot="back">
		<div class="meta">
			<span class="badge badge-index">第 {index} / {total} 题</span>
			<span class="badge badge-answer">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="12" height="12"
					><path
						fill="currentColor"
						d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"
					></path></svg
				>
				正确答案 {answer.correct}
			</span>
		</div>
		{
			correctOptions.length > 0 && (
				<ul class="options options-correct">
					{correctOptions.map((option) => (
						<li>{option}</li>
					))}
				</ul>
			)
		}
		{
			answer.explanation && (
				<section class="explain">
					<h3>解析</h3>
					<p>{answer.explanation}</p>
				</section>
			)
		}
		{
			answer.aiExplanation && (
				<section class="explain">
					<h3>AI 解析</h3>
					<p>{answer.aiExplanation}</p>
				</section>
			)
		}
	</Fragment>
</FlipCard>

<style>
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 1em;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		padding: 0.2em 0.8em;
		font-size: 0.78em;
		font-weight: 600;
		line-height: 1.6;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
	.badge-index {
		background: rgba(var(--gray), 15%);
		font-variant-numeric: tabular-nums;
	}
	.badge-type {
		background: rgba(35, 55, 255, 10%);
		color: var(--accent-dark);
	}
	.badge-answer {
		background: linear-gradient(135deg, var(--accent), var(--accent-dark));
		color: #fff;
	}
	.stem {
		margin: 0 0 1.1em;
		font-weight: 700;
		font-size: 1.05em;
		line-height: 1.5;
		color: rgb(var(--black));
	}
	.options {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.options li {
		margin-bottom: 0.6em;
		padding: 0.15em 0;
	}
	.options-correct li {
		padding: 0.55em 0.9em;
		border-left: 4px solid var(--accent);
		background: rgba(var(--gray-light), 60%);
		border-radius: 0 8px 8px 0;
	}
	.explain {
		margin-top: 1.3em;
		padding-top: 1em;
		border-top: 1px dashed rgb(var(--gray-light));
	}
	.explain h3 {
		margin: 0 0 0.4em;
		font-size: 0.95em;
		color: rgb(var(--gray-dark));
	}
	.explain p {
		margin: 0;
		/* 解析里带 \n，保留换行才不会糊成一大坨。 */
		white-space: pre-line;
	}
</style>
